# Copy to .env and fill in. Never commit the real .env.

# --- LLM (scoring judgment pass + resume tailoring) ---
ANTHROPIC_API_KEY=

# --- Aggregator job API (pick one; used by jobsearch/sources/aggregator.py) ---
# JSearch (via RapidAPI)
JSEARCH_API_KEY=
# Adzuna
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# --- Delivery ---
# email digest via SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
DIGEST_EMAIL_TO=
DIGEST_EMAIL_FROM=
# Slack digest (alternative to email)
SLACK_WEBHOOK_URL=

# --- LinkedIn scraper (feature-flagged, off by default; see criteria.yaml linkedin.enabled) ---
# Playwright will use a persistent browser profile at data/.linkedin-profile so you log in once.
