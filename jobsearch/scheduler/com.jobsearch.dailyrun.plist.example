<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
macOS launchd alternative to cron — more reliable across sleep/wake since
launchd will run the job shortly after wake if the machine was asleep at
the scheduled time (cron just skips a missed run).

Install:
  1. Replace /ABSOLUTE/PATH/TO/ClaudeResumeExperiment below with your real
     checkout path (must be absolute — launchd does not expand ~ or $HOME).
  2. cp com.jobsearch.dailyrun.plist.example ~/Library/LaunchAgents/com.jobsearch.dailyrun.plist
  3. launchctl load ~/Library/LaunchAgents/com.jobsearch.dailyrun.plist

Uninstall:
  launchctl unload ~/Library/LaunchAgents/com.jobsearch.dailyrun.plist
  rm ~/Library/LaunchAgents/com.jobsearch.dailyrun.plist
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.jobsearch.dailyrun</string>

    <key>ProgramArguments</key>
    <array>
        <string>/ABSOLUTE/PATH/TO/ClaudeResumeExperiment/jobsearch/scheduler/run_daily.sh</string>
    </array>

    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>7</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>/ABSOLUTE/PATH/TO/ClaudeResumeExperiment/data/logs/launchd.log</string>
    <key>StandardErrorPath</key>
    <string>/ABSOLUTE/PATH/TO/ClaudeResumeExperiment/data/logs/launchd.log</string>

    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
